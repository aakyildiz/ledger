{
  "name": "03 revert of an already reverted transaction (no opt-in)",
  "setup": [
    {"createLedger": {"name": "o-rej-l1"}},
    {"apply": {"ledger": "o-rej-l1", "action": {"createTransaction": {"postings": [{"source": "world", "destination": "users:1", "asset": "COIN", "amount": {"v0": "5"}}]}}}},
    {"apply": {"ledger": "o-rej-l1", "action": {"revertTransaction": {"transactionId": "1", "force": true}}}}
  ],
  "requests": [{"apply": {"ledger": "o-rej-l1", "action": {"revertTransaction": {"transactionId": "1", "force": true, "atEffectiveDate": true, "metadata": {"k0": {"stringValue": "v0"}}}}}}],
  "expectReason": "TRANSACTION_ALREADY_REVERTED"
}
