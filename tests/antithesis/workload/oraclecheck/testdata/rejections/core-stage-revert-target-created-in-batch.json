{
  "name": "01-revert-target-created-in-batch",
  "setup": [
    {
      "createLedger": {
        "defaultEnforcementMode": "CHART_ENFORCEMENT_AUDIT",
        "name": "o-rej-l1"
      }
    }
  ],
  "requests": [
    {
      "apply": {
        "action": {
          "createTransaction": {
            "postings": [
              {
                "amount": {
                  "v0": "1"
                },
                "asset": "USD",
                "destination": "users:1",
                "source": "world"
              }
            ]
          }
        },
        "ledger": "o-rej-l1"
      }
    },
    {
      "apply": {
        "action": {
          "revertTransaction": {
            "force": true,
            "transactionId": "1"
          }
        },
        "ledger": "o-rej-l1"
      }
    }
  ],
  "expectReason": "REVERT_TARGET_CREATED_IN_BATCH"
}
